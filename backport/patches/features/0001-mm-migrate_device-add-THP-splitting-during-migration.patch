 				!(src_pfns[i] & MIGRATE_PFN_COMPOUND)) {
@@ -1123,10 +1185,6 @@ static void __migrate_device_pages(unsigned long *src_pfns,
 		if (is_device_private_page(newpage) ||
 		    is_device_coherent_page(newpage)) {
 			if (mapping) {
-				struct folio *folio;
-
-				folio = page_folio(page);
