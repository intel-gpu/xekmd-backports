From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Varun Gupta <varun.gupta@intel.com>
Date: Tue, 20 Oct 2026 10:00:00 +0000
Subject: drm/xe: avoid foreign resv tag recovery on xe imports

Only recover tagged dma-resv pointers on imported BO teardown when the
import came from a non-xe exporter. For xe to xe imports, preserve the
shared reservation object state and let local inline reservation cleanup
happen in drm_gem_object_release() compat wrapping.

Also add a helper to identify xe dma-buf exporters.

Signed-off-by: Varun Gupta <varun.gupta@intel.com>
---
 src/drivers/gpu/drm/xe/xe_bo.c      | 12 +++++++++++-
 src/drivers/gpu/drm/xe/xe_dma_buf.c |  5 +++++
 src/drivers/gpu/drm/xe/xe_dma_buf.h |  3 +++
 3 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/xe/xe_bo.c b/drivers/gpu/drm/xe/xe_bo.c
index 8e9bc422f..bef139ed4 100644
--- a/drivers/gpu/drm/xe/xe_bo.c
+++ b/drivers/gpu/drm/xe/xe_bo.c
@@ -1849,8 +1849,18 @@
 	struct xe_tile *tile;
 	u8 id;
 
-	if (bo->ttm.base.import_attach)
+	if (bo->ttm.base.import_attach) {
+#ifdef BPM_DMA_RESV_USAGE_NOT_PRESENT
+		struct dma_buf *imported_dma_buf = bo->ttm.base.import_attach->dmabuf;
+
+		if (!xe_dma_buf_is_xe_exporter(imported_dma_buf)) {
+			dma_resv_lock(bo->ttm.base.resv, NULL);
+			dma_resv_recover_ptr(bo->ttm.base.resv);
+			dma_resv_unlock(bo->ttm.base.resv);
+		}
+#endif
 		drm_prime_gem_destroy(&bo->ttm.base, NULL);
+	}
 	if (bo->dma_buf)
 		dma_buf_put(bo->dma_buf);
 	drm_gem_object_release(&bo->ttm.base);
diff --git a/drivers/gpu/drm/xe/xe_dma_buf.c b/drivers/gpu/drm/xe/xe_dma_buf.c
index de6999f89..15a2290b4 100644
--- a/drivers/gpu/drm/xe/xe_dma_buf.c
+++ b/drivers/gpu/drm/xe/xe_dma_buf.c
@@ -222,6 +222,11 @@
 	.vunmap = drm_gem_dmabuf_vunmap,
 };
 
+bool xe_dma_buf_is_xe_exporter(const struct dma_buf *dma_buf)
+{
+	return dma_buf && dma_buf->ops == &xe_dmabuf_ops;
+}
+
 struct dma_buf *xe_gem_prime_export(struct drm_gem_object *obj, int flags)
 {
 	struct xe_bo *bo = gem_to_xe_bo(obj);
diff --git a/drivers/gpu/drm/xe/xe_dma_buf.h b/drivers/gpu/drm/xe/xe_dma_buf.h
index b95fd3852..b8e7d6f3a 100644
--- a/drivers/gpu/drm/xe/xe_dma_buf.h
+++ b/drivers/gpu/drm/xe/xe_dma_buf.h
@@ -8,8 +8,11 @@
 
 #include <drm/drm_gem.h>
 
+struct dma_buf;
+
 struct dma_buf *xe_gem_prime_export(struct drm_gem_object *obj, int flags);
 struct drm_gem_object *xe_gem_prime_import(struct drm_device *dev,
 					   struct dma_buf *dma_buf);
+bool xe_dma_buf_is_xe_exporter(const struct dma_buf *dma_buf);
 
 #endif
-- 
