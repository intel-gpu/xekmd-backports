From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kanaka Raju Nayana <kanaka.raju.nayana@intel.com>
Date: Tue, 1 Sep 2026 02:45:41 +0530
Subject: drm/drm_ras: add DRM RAS dump info helper

drm_ras uses a generic netlink dump helper while building dump
command handlers. older kernels do not provide this helper, which
causes drm_ras compilation to fail.

Add compatibility handling for the missing dump helper so drm_ras
can build and use the older dump callback path where needed.

Signed-off-by: Kanaka Raju Nayana <kanaka.raju.nayana@intel.com>
---
 drivers/gpu/drm/drm_ras.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/gpu/drm/drm_ras.c b/drivers/gpu/drm/drm_ras.c
index b099eb6..b8a65f4 100644
--- a/drivers/gpu/drm/drm_ras.c
+++ b/drivers/gpu/drm/drm_ras.c
@@ -125,7 +125,9 @@ struct drm_ras_ctx {
 int drm_ras_nl_list_nodes_dumpit(struct sk_buff *skb,
 				 struct netlink_callback *cb)
 {
+#ifndef BPM_GENL_INFO_DUMP_NOT_PRESENT
 	const struct genl_info *info = genl_info_dump(cb);
+#endif
 	struct drm_ras_ctx *ctx = (void *)cb->ctx;
 	struct drm_ras_node *node;
 	struct nlattr *hdr;
@@ -449,7 +451,9 @@ EXPORT_SYMBOL(drm_ras_nl_error_event);
 int drm_ras_nl_get_error_counter_dumpit(struct sk_buff *skb,
 					struct netlink_callback *cb)
 {
+#ifndef BPM_GENL_INFO_DUMP_NOT_PRESENT
 	const struct genl_info *info = genl_info_dump(cb);
+#endif
 	struct drm_ras_ctx *ctx = (void *)cb->ctx;
 	struct drm_ras_node *node;
 	struct nlattr *hdr;
@@ -457,10 +461,24 @@ int drm_ras_nl_get_error_counter_dumpit(struct sk_buff *skb,
 	u32 node_id, error_id, value;
 	int ret;
 
+#ifdef BPM_GENL_INFO_DUMP_NOT_PRESENT
+	struct nlattr *tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID + 1];
+
+	if (nlmsg_parse(cb->nlh, GENL_HDRLEN, tb,
+                        DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID,
+                        NULL, NULL))
+                return -EINVAL;
+
+        if (!tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID])
+                return -EINVAL;
+
+        node_id = nla_get_u32(tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID]);
+#else
 	if (!info->attrs || GENL_REQ_ATTR_CHECK(info, DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID))
 		return -EINVAL;
 
 	node_id = nla_get_u32(info->attrs[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID]);
+#endif
 
 	node = xa_load(&drm_ras_xa, node_id);
 	if (!node)
-- 
