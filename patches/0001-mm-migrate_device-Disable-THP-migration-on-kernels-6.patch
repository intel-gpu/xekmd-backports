From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pravalika Gurram <pravalika.gurram@intel.com>
Date: Mon, 13 Jul 2026 20:54:29 +0530
Subject: [PATCH] mm/migrate_device: Disable THP migration on kernels < 6.19

Disable THP migration when MIGRATE_VMA_SELECT_COMPOUND and
MIGRATE_PFN_COMPOUND flags are unavailable (kernel < 6.19).

THP pages fall back to splitting and 4KB page-by-page migration.

LIMITATIONS:
- Zone device memory fragmented into 4KB pages

Reference:
	a30b48bf1b2
	mm/migrate_device: implement THP migration of zone device pages

v1: Rebase to v7.3 kernel [Raju]

Signed-off-by: Pravalika Gurram <pravalika.gurram@intel.com>
Signed-off-by: Kanaka Raju Nayana <kanaka.raju.nayana@intel.com>
---
 drivers/gpu/drm/drm_pagemap.c | 39 +++++++++++++++++++++++++++++++++++++--
 1 file changed, 37 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/drm_pagemap.c b/drivers/gpu/drm/drm_pagemap.c
index 2b300c116..b2e5e97eb 100644
--- a/drivers/gpu/drm/drm_pagemap.c
+++ b/drivers/gpu/drm/drm_pagemap.c
@@ -419,13 +419,16 @@ static void drm_pagemap_migrate_populate_src_pages(struct page **pages,
 	for (i = 0; i < npages;) {
 		struct page *page = migrate_pfn_to_page(src_mpfn[i]);
 		unsigned int order = 0;
+#ifndef BPM_MIGRATE_VMA_SELECT_COMPOUND_NOT_PRESENT
 		unsigned long j, nr;
+#endif
 
 		if (!page) {
 			i++;
 			continue;
 		}
 
+#ifndef BPM_MIGRATE_VMA_SELECT_COMPOUND_NOT_PRESENT
 		order = folio_order(page_folio(page));
 		nr = NR_PAGES(order);
 
@@ -437,6 +440,10 @@ static void drm_pagemap_migrate_populate_src_pages(struct page **pages,
 		}
 
 		i += nr;
+#else
+		pages[i] = page;
+		i += NR_PAGES(order);
+#endif
 	}
 }
 
@@ -611,6 +618,7 @@ out:
 	return ret;
 }
 
+#ifndef BPM_MIGRATE_VMA_SELECT_COMPOUND_NOT_PRESENT
 /**
  * drm_pagemap_cpages() - Count collected pages
  * @migrate_pfn: Array of migrate_pfn entries to account
@@ -645,6 +653,7 @@ static int drm_pagemap_cpages(unsigned long *migrate_pfn, unsigned long npages)
 
 	return cpages;
 }
+#endif
 
 /**
  * drm_pagemap_migrate_to_devmem() - Migrate a struct mm_struct range to device memory
@@ -682,8 +691,13 @@ int drm_pagemap_migrate_to_devmem(struct drm_pagemap_devmem *devmem_allocation,
 		.start		= start,
 		.end		= end,
 		.pgmap_owner	= pagemap->owner,
+#ifdef BPM_MIGRATE_VMA_SELECT_COMPOUND_NOT_PRESENT
+		.flags		= MIGRATE_VMA_SELECT_SYSTEM | MIGRATE_VMA_SELECT_DEVICE_COHERENT |
+		MIGRATE_VMA_SELECT_DEVICE_PRIVATE,
+#else
 		.flags		= MIGRATE_VMA_SELECT_SYSTEM | MIGRATE_VMA_SELECT_DEVICE_COHERENT |
 		MIGRATE_VMA_SELECT_DEVICE_PRIVATE | MIGRATE_VMA_SELECT_COMPOUND,
+#endif
 	};
 	unsigned long i, npages = npages_in_range(start, end);
 	unsigned long own_pages = 0, migrated_pages = 0;
@@ -748,8 +762,12 @@ int drm_pagemap_migrate_to_devmem(struct drm_pagemap_devmem *devmem_allocation,
 		goto err_free;
 	}
 
+#ifdef BPM_MIGRATE_VMA_SELECT_COMPOUND_NOT_PRESENT
+	if (migrate.cpages != npages) {
+#else
 	if (migrate.cpages != npages &&
 	    drm_pagemap_cpages(migrate.src, npages) != npages) {
+#endif
 		/*
 		 * Some pages to migrate. But we want to migrate all or
 		 * nothing. Raced or unknown device pages.
@@ -792,7 +810,6 @@ int drm_pagemap_migrate_to_devmem(struct drm_pagemap_devmem *devmem_allocation,
 	own_pages = 0;
 
 	for (i = 0; i < npages;) {
-		unsigned long j;
 		struct page *page = pfn_to_page(migrate.dst[i]);
 		struct page *src_page = migrate_pfn_to_page(migrate.src[i]);
 		unsigned int order = 0;
@@ -822,7 +839,10 @@ int drm_pagemap_migrate_to_devmem(struct drm_pagemap_devmem *devmem_allocation,
 		}
 		migrate.dst[i] = migrate_pfn(migrate.dst[i]);
 
+#ifndef BPM_MIGRATE_VMA_SELECT_COMPOUND_NOT_PRESENT
 		if (migrate.src[i] & MIGRATE_PFN_COMPOUND) {
+			unsigned long j;
+
 			drm_WARN_ONCE(dpagemap->drm, src_page &&
 				      folio_order(page_folio(src_page)) != HPAGE_PMD_ORDER,
 				      "Unexpected folio order\n");
@@ -833,7 +853,7 @@ int drm_pagemap_migrate_to_devmem(struct drm_pagemap_devmem *devmem_allocation,
 			for (j = 1; j < NR_PAGES(order) && i + j < npages; j++)
 				migrate.dst[i + j] = 0;
 		}
-
+#endif
 		drm_pagemap_get_devmem_page(page, order, zdd);
 
 		/* If we switched the migrating drm_pagemap, migrate previous pages now */
@@ -947,6 +967,7 @@ static int drm_pagemap_migrate_populate_ram_pfn(struct vm_area_struct *vas,
 				goto next;
 		}
 
+#ifndef BPM_MIGRATE_VMA_SELECT_COMPOUND_NOT_PRESENT
 		order = folio_order(page_folio(src_page));
 
 		/*
@@ -961,6 +982,9 @@ static int drm_pagemap_migrate_populate_ram_pfn(struct vm_area_struct *vas,
 		WARN_ON_ONCE(order &&
 			     (src_page != folio_page(page_folio(src_page), 0) ||
 			      !(src_mpfn[i] & MIGRATE_PFN_COMPOUND)));
+#else
+		WARN_ON_ONCE(folio_order(page_folio(src_page)));
+#endif
 
 		if (order)
 			gfp |= __GFP_NOWARN;
@@ -1009,8 +1033,10 @@ static int drm_pagemap_migrate_populate_ram_pfn(struct vm_area_struct *vas,
 		page = folio_page(folio, 0);
 		mpfn[i] = migrate_pfn(page_to_pfn(page));
 
+#ifndef BPM_MIGRATE_VMA_SELECT_COMPOUND_NOT_PRESENT
 		if (order)
 			mpfn[i] |= MIGRATE_PFN_COMPOUND;
+#endif
 next:
 		if (page)
 			addr += page_size(page);
@@ -1266,8 +1292,10 @@ static void drm_pagemap_retire_migrated_pages(unsigned long *src_pfns,
 			continue;
 		}
 
+#ifndef BPM_MIGRATE_VMA_SELECT_COMPOUND_NOT_PRESENT
 		if (src_pfns[i] & MIGRATE_PFN_COMPOUND)
 			nr = folio_nr_pages(page_folio(page));
+#endif
 
 		if ((src_pfns[i] & MIGRATE_PFN_MIGRATE) &&
 		    is_device_private_page(page))
@@ -1300,8 +1328,10 @@ static void drm_pagemap_skip_retired_pages(unsigned long *src_pfns,
 			continue;
 		}
 
+#ifndef BPM_MIGRATE_VMA_SELECT_COMPOUND_NOT_PRESENT
 		if (src_pfns[i] & MIGRATE_PFN_COMPOUND)
 			nr = folio_nr_pages(page_folio(page));
+#endif
 
 		if ((src_pfns[i] & MIGRATE_PFN_MIGRATE) &&
 		    is_device_private_page(page) &&
@@ -1434,9 +1464,14 @@ static int __drm_pagemap_migrate_to_ram(struct vm_area_struct *vas,
 	struct migrate_vma migrate = {
 		.vma		= vas,
 		.pgmap_owner	= page_pgmap(page)->owner,
+#ifdef BPM_MIGRATE_VMA_SELECT_COMPOUND_NOT_PRESENT
+		.flags		= MIGRATE_VMA_SELECT_DEVICE_PRIVATE |
+				  MIGRATE_VMA_SELECT_DEVICE_COHERENT,
+#else
 		.flags		= MIGRATE_VMA_SELECT_DEVICE_PRIVATE |
 				  MIGRATE_VMA_SELECT_DEVICE_COHERENT |
 				  MIGRATE_VMA_SELECT_COMPOUND,
+#endif
 		.fault_page	= page,
 	};
 	struct drm_pagemap_iova_state state = {};
-- 
2.43.0
