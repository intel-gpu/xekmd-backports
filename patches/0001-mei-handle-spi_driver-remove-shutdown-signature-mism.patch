From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kanaka Raju Nayana <kanaka.raju.nayana@intel.com>
Date: Mon, 10 Aug 2026 22:13:32 +0530
Subject: mei: handle spi_driver remove/shutdown signature mismatch in
 vsc-tp

Older kernels expect spi_driver.remove to return int, while newer kernels
use void. This causes callback type mismatch errors in vsc-tp.

Add a compatibility guard for the SPI remove signature, switch
vsc_tp_remove between int/void accordingly, and guard shutdown
wiring so callback types remain valid in both API variants.

Signed-off-by: Kanaka Raju Nayana <kanaka.raju.nayana@intel.com>
---
 drivers/misc/mei/vsc-tp.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/misc/mei/vsc-tp.c b/drivers/misc/mei/vsc-tp.c
index 5ecf998..77e2a63 100644
--- a/drivers/misc/mei/vsc-tp.c
+++ b/drivers/misc/mei/vsc-tp.c
@@ -538,7 +538,11 @@ err_destroy_lock:
 }
 
 /* Note this is also used for shutdown */
+#ifdef BPM_SPI_DRIVER_REMOVE_RETURN_VOID_NOT_PRESENT
+static int vsc_tp_remove(struct spi_device *spi)
+#else
 static void vsc_tp_remove(struct spi_device *spi)
+#endif
 {
 	struct vsc_tp *tp = spi_get_drvdata(spi);
 
@@ -549,8 +553,19 @@ static void vsc_tp_remove(struct spi_device *spi)
 	cancel_work_sync(&tp->event_work);
 	mutex_destroy(&tp->event_notify_mutex);
 	mutex_destroy(&tp->mutex);
+
+#ifdef BPM_SPI_DRIVER_REMOVE_RETURN_VOID_NOT_PRESENT
+	return 0;
+#endif
 }
 
+#ifdef BPM_SPI_DRIVER_REMOVE_RETURN_VOID_NOT_PRESENT
+static void vsc_tp_shutdown(struct spi_device *spi)
+{
+	(void)vsc_tp_remove(spi);
+}
+#endif
+
 static const struct acpi_device_id vsc_tp_acpi_ids[] = {
 	{ "INTC1009" }, /* Raptor Lake */
 	{ "INTC1058" }, /* Tiger Lake */
@@ -563,7 +578,13 @@ MODULE_DEVICE_TABLE(acpi, vsc_tp_acpi_ids);
 static struct spi_driver vsc_tp_driver = {
 	.probe = vsc_tp_probe,
 	.remove = vsc_tp_remove,
+
+#ifdef BPM_SPI_DRIVER_REMOVE_RETURN_VOID_NOT_PRESENT
+	.shutdown = vsc_tp_shutdown,
+#else
 	.shutdown = vsc_tp_remove,
+#endif
+
 	.driver = {
 		.name = "vsc-tp",
 		.acpi_match_table = vsc_tp_acpi_ids,
-- 
