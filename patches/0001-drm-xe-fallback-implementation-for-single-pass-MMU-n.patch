 	struct drm_gpusvm_range *r, *first;
 	struct xe_tile *tile;
@@ -278,10 +282,15 @@ static void xe_svm_invalidate(struct drm_gpusvm *gpusvm,
 
 	xe_device_wmb(xe);
 
+#ifdef BPM_MMU_INTERVAL_NOTIFIER_TWOPASS_NOT_PRESENT
