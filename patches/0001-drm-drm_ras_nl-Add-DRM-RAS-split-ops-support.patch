From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kanaka Raju Nayana <kanaka.raju.nayana@intel.com>
Date: Wed, 2 Sep 2026 20:38:13 +0530
Subject: [PATCH] drm/drm_ras_nl: Add DRM RAS split ops support

drm_ras uses split operation tables while registering its generic
netlink command handlers. older kernels do not provide this API, which
causes drm_ras compilation to fail.

Add compatibility handling for the missing split operation support
so drm_ras can register its handlers through the older operation
table where needed.

Signed-off-by: Kanaka Raju Nayana <kanaka.raju.nayana@intel.com>
---
 drivers/gpu/drm/drm_ras.c    | 36 ++++++++++++++++++++++++++++++++
 drivers/gpu/drm/drm_ras_nl.c | 36 ++++++++++++++++++++++++++++++++
 2 files changed, 72 insertions(+)

diff --git a/drivers/gpu/drm/drm_ras.c b/drivers/gpu/drm/drm_ras.c
index b8a65f4..279ec3c 100644
--- a/drivers/gpu/drm/drm_ras.c
+++ b/drivers/gpu/drm/drm_ras.c
@@ -597,6 +597,21 @@ int drm_ras_nl_get_error_threshold_doit(struct sk_buff *skb, struct genl_info *i
 {
 	u32 node_id, error_id;
 
+#ifdef BPM_GENL_SPLIT_OPS_NOT_PRESENT
+    	struct nlattr *tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID + 1];
+
+    	if (genlmsg_parse(info->nlhdr, &drm_ras_nl_family, tb,
+	    DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID, NULL,
+            info->extack))
+        	return -EINVAL;
+
+    	if (!tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID] ||
+            !tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID])
+        	return -EINVAL;
+
+    	node_id = nla_get_u32(tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID]);
+    	error_id = nla_get_u32(tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID]);
+#else
 	if (!info->attrs ||
 	    GENL_REQ_ATTR_CHECK(info, DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID) ||
 	    GENL_REQ_ATTR_CHECK(info, DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID))
@@ -604,6 +619,7 @@ int drm_ras_nl_get_error_threshold_doit(struct sk_buff *skb, struct genl_info *i
 
 	node_id = nla_get_u32(info->attrs[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID]);
 	error_id = nla_get_u32(info->attrs[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID]);
+#endif
 
 	return doit_reply_threshold(info, node_id, error_id);
 }
@@ -621,6 +637,25 @@ int drm_ras_nl_get_error_threshold_doit(struct sk_buff *skb, struct genl_info *i
 int drm_ras_nl_set_error_threshold_doit(struct sk_buff *skb, struct genl_info *info)
 {
 	u32 node_id, error_id, threshold;
+	
+#ifdef BPM_GENL_SPLIT_OPS_NOT_PRESENT
+    	struct nlattr *tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_THRESHOLD + 1];
+
+    	if (genlmsg_parse(info->nlhdr, &drm_ras_nl_family, tb,
+            DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_THRESHOLD, NULL,
+            info->extack))
+        	return -EINVAL;
+
+    	if (!tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID] ||
+            !tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID] ||
+            !tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_THRESHOLD])
+        	return -EINVAL;
+
+    	node_id = nla_get_u32(tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID]);
+    	error_id = nla_get_u32(tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID]);
+    	threshold = nla_get_u32(
+        tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_THRESHOLD]);
+#else
 
 	if (!info->attrs ||
 	    GENL_REQ_ATTR_CHECK(info, DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID) ||
@@ -631,6 +666,7 @@ int drm_ras_nl_set_error_threshold_doit(struct sk_buff *skb, struct genl_info *i
 	node_id = nla_get_u32(info->attrs[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID]);
 	error_id = nla_get_u32(info->attrs[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID]);
 	threshold = nla_get_u32(info->attrs[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_THRESHOLD]);
+#endif
 
 	return set_node_error_threshold(node_id, error_id, threshold);
 }
diff --git a/drivers/gpu/drm/drm_ras_nl.c b/drivers/gpu/drm/drm_ras_nl.c
index c9f5e0c..b82ec2e 100644
--- a/drivers/gpu/drm/drm_ras_nl.c
+++ b/drivers/gpu/drm/drm_ras_nl.c
@@ -42,6 +42,36 @@ static const struct nla_policy drm_ras_set_error_threshold_nl_policy[DRM_RAS_A_E
 };
 
 /* Ops table for drm_ras */
+#ifdef BPM_GENL_SPLIT_OPS_NOT_PRESENT
+static const struct genl_small_ops drm_ras_nl_ops[] = {
+    {
+        .cmd		= DRM_RAS_CMD_LIST_NODES,
+        .dumpit		= drm_ras_nl_list_nodes_dumpit,
+        .flags		= GENL_ADMIN_PERM,
+    },
+    {
+        .cmd		= DRM_RAS_CMD_GET_ERROR_COUNTER,
+        .doit		= drm_ras_nl_get_error_counter_doit,
+        .dumpit		= drm_ras_nl_get_error_counter_dumpit,
+        .flags		= GENL_ADMIN_PERM,
+    },
+    {
+        .cmd		= DRM_RAS_CMD_CLEAR_ERROR_COUNTER,
+        .doit		= drm_ras_nl_clear_error_counter_doit,
+        .flags		= GENL_ADMIN_PERM,
+    },
+    {
+        .cmd		= DRM_RAS_CMD_GET_ERROR_THRESHOLD,
+        .doit		= drm_ras_nl_get_error_threshold_doit,
+        .flags		= GENL_ADMIN_PERM,
+    },
+    {
+        .cmd		= DRM_RAS_CMD_SET_ERROR_THRESHOLD,
+        .doit		= drm_ras_nl_set_error_threshold_doit,
+        .flags		= GENL_ADMIN_PERM,
+    },
+};
+#else
 static const struct genl_split_ops drm_ras_nl_ops[] = {
 	{
 		.cmd	= DRM_RAS_CMD_LIST_NODES,
@@ -84,6 +114,7 @@ static const struct genl_split_ops drm_ras_nl_ops[] = {
 		.flags		= GENL_ADMIN_PERM | GENL_CMD_CAP_DO,
 	},
 };
+#endif
 
 static const struct genl_multicast_group drm_ras_nl_mcgrps[] = {
 	[DRM_RAS_NLGRP_ERROR_REPORT] = { "error-report", },
@@ -95,8 +126,13 @@ struct genl_family drm_ras_nl_family __ro_after_init = {
 	.netnsok	= true,
 	.parallel_ops	= true,
 	.module		= THIS_MODULE,
+#ifdef BPM_GENL_SPLIT_OPS_NOT_PRESENT
+	.small_ops      = drm_ras_nl_ops,
+	.n_small_ops    = ARRAY_SIZE(drm_ras_nl_ops),
+#else
 	.split_ops	= drm_ras_nl_ops,
 	.n_split_ops	= ARRAY_SIZE(drm_ras_nl_ops),
+#endif
 	.mcgrps		= drm_ras_nl_mcgrps,
 	.n_mcgrps	= ARRAY_SIZE(drm_ras_nl_mcgrps),
 };
-- 
2.43.0
