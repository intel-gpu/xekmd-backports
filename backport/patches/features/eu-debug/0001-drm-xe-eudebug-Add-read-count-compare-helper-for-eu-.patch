--- a/drivers/gpu/drm/xe/xe_eudebug_types.h
+++ b/drivers/gpu/drm/xe/xe_eudebug_types.h
@@ -17,6 +17,8 @@
 #include <linux/xarray.h>
 
 #include <uapi/drm/xe_drm.h>
+#include "xe_gt_debug.h"
