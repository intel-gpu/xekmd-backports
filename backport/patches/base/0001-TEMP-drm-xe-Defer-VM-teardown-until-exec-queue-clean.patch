diff --git a/drivers/gpu/drm/xe/xe_device.c b/drivers/gpu/drm/xe/xe_device.c
index a42388cf4..15b03e454 100644
--- a/drivers/gpu/drm/xe/xe_device.c
+++ b/drivers/gpu/drm/xe/xe_device.c
@@ -178,6 +178,7 @@ static void xe_file_close(struct drm_device *dev, struct drm_file *file)
 	struct xe_file *xef = file->driver_priv;
 	struct xe_vm *vm;
 	struct xe_exec_queue *q;
+	bool close_deferred = false;
 	unsigned long idx;
 
 	guard(xe_pm_runtime)(xe);
@@ -197,16 +198,22 @@ static void xe_file_close(struct drm_device *dev, struct drm_file *file)
 	xa_for_each(&xef->exec_queue.xa, idx, q) {
 		if (q->vm && q->hwe->hw_engine_group)
 			xe_hw_engine_group_del_exec_queue(q->hwe->hw_engine_group, q);
-		xe_exec_queue_kill(q);
+		if (!(q->flags & EXEC_QUEUE_FLAG_VM))
+			xe_exec_queue_kill(q);
 	}
 
 	xa_for_each(&xef->exec_queue.xa, idx, q) {
-		xe_exec_queue_kill_sync(q);
+		if (!(q->flags & EXEC_QUEUE_FLAG_VM))
+			xe_exec_queue_kill_sync(q);
 		xe_exec_queue_put(q);
 	}
 
 	xa_for_each(&xef->vm.xa, idx, vm)
-		xe_vm_close_and_put(vm);
+		close_deferred |= xe_vm_close_and_put_deferred(vm);
+
+	if (close_deferred)
+		drm_dbg(&xe->drm,
+			"VM teardown deferred until exec queue cleanup completes\n");
 
 	xe_file_put(xef);
 }
