From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matthew Auld <matthew.auld@intel.com>
Date: Thu, 19 Nov 2026 11:14:36 +0000
Subject: [PATCH] [TEMP] drm/xe: run compute rebind worker on device NUMA node
preempt_rebind_work_func() currently runs on xe->ordered_wq, whose
unbound worker pool spans all NUMA nodes. On multi-socket systems, if
the rebind worker runs on a remote socket when faulting userptr pages
marked PROT_NONE by AutoNUMA, hmm_range_fault() invokes do_numa_page()
using the worker's NUMA node and triggers migrate_misplaced_folio(),
pulling pages away from the GPU's local node and causing self-inflicted
MMU notifier invalidations.

Move vm->preempt.rebind_work onto a dedicated WQ_UNBOUND workqueue
(max_active = 1) queued via queue_work_node() with dev_to_node(),
leaving user-fence signalling on xe->ordered_wq. Guard
preempt_rebind_work_func() with a per-device mutex so compute rebinds
remain strictly 1-at-a-time even when queue_work_node() falls back
across nodes (such as NUMA_NO_NODE or CPU-less nodes).

Signed-off-by: Matthew Auld <matthew.auld@intel.com>
(cherry-picked from https://patchwork.freedesktop.org/series/179052/#rev1)
Signed-off-by: Pravalika Gurram <pravalika.gurram@intel.com>
---
 drivers/gpu/drm/xe/xe_device.c       | 11 ++++++++++-
 drivers/gpu/drm/xe/xe_device_types.h |  9 ++++++++-
 drivers/gpu/drm/xe/xe_vm.c           |  8 +++++++-
 drivers/gpu/drm/xe/xe_vm.h           |  6 +++++-
 4 files changed, 30 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/xe/xe_device.c b/drivers/gpu/drm/xe/xe_device.c
index 8ce6b7508..af4bb3b2f 100644
--- a/drivers/gpu/drm/xe/xe_device.c
+++ b/drivers/gpu/drm/xe/xe_device.c
@@ -7,9 +7,11 @@
 
 #include <linux/aperture.h>
 #include <linux/delay.h>
+#include <linux/mutex.h>
 #include <linux/fault-inject.h>
 #include <linux/jiffies.h>
 #include <linux/units.h>
+#include <linux/workqueue.h>
 
 #include <drm/drm_client.h>
 #include <drm/drm_gem_ttm_helper.h>
@@ -543,6 +545,11 @@ static void xe_device_destroy(struct drm_device *dev, void *dummy)
 	if (xe->destroy_wq)
 		destroy_workqueue(xe->destroy_wq);
 
+	if (xe->rebind_wq)
+		destroy_workqueue(xe->rebind_wq);
+
+	mutex_destroy(&xe->rebind_lock);
+
 	ttm_device_fini(&xe->ttm);
 
 	if (atomic_dec_and_test(&xe_device_count))
@@ -619,6 +626,7 @@ int xe_device_init_early(struct xe_device *xe)
 		return err;
 
 	xe_bo_dev_init(&xe->bo_device);
+	mutex_init(&xe->rebind_lock);
 	atomic_inc(&xe_device_count);
 	err = drmm_add_action_or_reset(&xe->drm, xe_device_destroy, NULL);
 	if (err)
@@ -665,10 +673,11 @@ int xe_device_init_early(struct xe_device *xe)
 
 	xe->preempt_fence_wq = alloc_ordered_workqueue("xe-preempt-fence-wq",
 						       WQ_MEM_RECLAIM);
+	xe->rebind_wq = alloc_workqueue("xe-rebind-wq", WQ_UNBOUND, 1);
 	xe->ordered_wq = alloc_ordered_workqueue("xe-ordered-wq", 0);
 	xe->unordered_wq = alloc_workqueue("xe-unordered-wq", WQ_PERCPU, 0);
 	xe->destroy_wq = alloc_workqueue("xe-destroy-wq", WQ_PERCPU | WQ_MEM_RECLAIM, 0);
-	if (!xe->ordered_wq || !xe->unordered_wq ||
+	if (!xe->ordered_wq || !xe->unordered_wq || !xe->rebind_wq ||
 	    !xe->preempt_fence_wq || !xe->destroy_wq) {
 		/*
 		 * Cleanup done in xe_device_destroy via
diff --git a/drivers/gpu/drm/xe/xe_device_types.h b/drivers/gpu/drm/xe/xe_device_types.h
index a773afc5e..01cbe7147 100644
--- a/drivers/gpu/drm/xe/xe_device_types.h
+++ b/drivers/gpu/drm/xe/xe_device_types.h
@@ -6,6 +6,7 @@
 #ifndef _XE_DEVICE_TYPES_H_
 #define _XE_DEVICE_TYPES_H_
 
+#include <linux/mutex.h>
 #include <linux/pci.h>
 #include <linux/workqueue.h>
 
@@ -392,7 +393,13 @@ struct xe_device {
 	/** @preempt_fence_wq: used to serialize preempt fences */
 	struct workqueue_struct *preempt_fence_wq;
 
-	/** @ordered_wq: used to serialize compute mode resume */
+	/** @rebind_wq: used to run compute mode rebind work on device node */
+	struct workqueue_struct *rebind_wq;
+
+	/** @rebind_lock: serializes compute mode rebind workers per device */
+	struct mutex rebind_lock;
+
+	/** @ordered_wq: used to serialize ordered work */
 	struct workqueue_struct *ordered_wq;
 
 	/** @unordered_wq: used to serialize unordered work */
diff --git a/drivers/gpu/drm/xe/xe_vm.c b/drivers/gpu/drm/xe/xe_vm.c
index dcdc77511..1f3cda479 100644
--- a/drivers/gpu/drm/xe/xe_vm.c
+++ b/drivers/gpu/drm/xe/xe_vm.c
@@ -17,6 +17,7 @@
 #include <linux/delay.h>
 #include <linux/kthread.h>
 #include <linux/mm.h>
+#include <linux/mutex.h>
 #include <linux/sched/signal.h>
 #include <linux/swap.h>
 
@@ -511,7 +512,7 @@ static bool vm_suspend_rebind_worker(struct xe_vm *vm)
  */
 void xe_vm_resume_rebind_worker(struct xe_vm *vm)
 {
-	queue_work(vm->xe->ordered_wq, &vm->preempt.rebind_work);
+	xe_vm_queue_rebind_worker(vm);
 }
 
 #if IS_ENABLED(CONFIG_DRM_XE_USERPTR_INVAL_INJECT)
@@ -552,16 +553,19 @@ static void preempt_rebind_work_func(struct work_struct *w)
 	xe_assert(vm->xe, xe_vm_in_preempt_fence_mode(vm));
 	trace_xe_vm_rebind_worker_enter(vm);
 
+	mutex_lock(&vm->xe->rebind_lock);
 	down_write(&vm->lock);
 
 	if (xe_vm_is_closed_or_banned(vm)) {
 		up_write(&vm->lock);
+		mutex_unlock(&vm->xe->rebind_lock);
 		trace_xe_vm_rebind_worker_exit(vm);
 		return;
 	}
 
 	if (!try_wait_for_completion(&vm->xe->pm_block) && vm_suspend_rebind_worker(vm)) {
 		up_write(&vm->lock);
+		mutex_unlock(&vm->xe->rebind_lock);
 		/* We don't actually block but don't make progress. */
 		xe_pm_might_block_on_suspend();
 		return;
@@ -637,6 +641,7 @@ static void preempt_rebind_work_func(struct work_struct *w)
 		 * lock make progress between attempts.
 		 */
 		up_write(&vm->lock);
+		mutex_unlock(&vm->xe->rebind_lock);
 		free_preempt_fences(&preempt_fences);
 		xe_vm_queue_rebind_worker(vm);
 		trace_xe_vm_rebind_worker_exit(vm);
@@ -650,6 +655,7 @@ static void preempt_rebind_work_func(struct work_struct *w)
 		xe_vm_kill(vm, true);
 	}
 	up_write(&vm->lock);
+	mutex_unlock(&vm->xe->rebind_lock);
 
 	free_preempt_fences(&preempt_fences);
 
diff --git a/drivers/gpu/drm/xe/xe_vm.h b/drivers/gpu/drm/xe/xe_vm.h
index d6e0e4c96..fb770475e 100644
--- a/drivers/gpu/drm/xe/xe_vm.h
+++ b/drivers/gpu/drm/xe/xe_vm.h
@@ -6,6 +6,9 @@
 #ifndef _XE_VM_H_
 #define _XE_VM_H_
 
+#include <linux/device.h>
+#include <linux/workqueue.h>
+
 #include "xe_assert.h"
 #include "xe_bo_types.h"
 #include "xe_macros.h"
@@ -274,7 +277,8 @@ int xe_vm_validate_protected(struct xe_vm *vm);
 static inline void xe_vm_queue_rebind_worker(struct xe_vm *vm)
 {
 	xe_assert(vm->xe, xe_vm_in_preempt_fence_mode(vm));
-	queue_work(vm->xe->ordered_wq, &vm->preempt.rebind_work);
+	queue_work_node(dev_to_node(vm->xe->drm.dev), vm->xe->rebind_wq,
+			&vm->preempt.rebind_work);
 }
 
