 int xe_vm_validate_protected(struct xe_vm *vm);
 
diff --git a/drivers/gpu/drm/xe/xe_vm_madvise.c b/drivers/gpu/drm/xe/xe_vm_madvise.c
index c4fb290..4066483 100644
--- a/drivers/gpu/drm/xe/xe_vm_madvise.c
+++ b/drivers/gpu/drm/xe/xe_vm_madvise.c
@@ -316,20 +316,27 @@ static u8 xe_zap_ptes_in_madvise_range(struct xe_vm *vm, u64 start, u64 end)
 static int xe_vm_invalidate_madvise_range(struct xe_vm *vm, u64 start, u64 end)
 {
 	u8 tile_mask = xe_zap_ptes_in_madvise_range(vm, start, end);
+#ifndef BPM_MMU_INTERVAL_NOTIFIER_TWOPASS_NOT_PRESENT
 	struct xe_tlb_inval_batch batch;
 	int err;
+#endif
 
 	if (!tile_mask)
 		return 0;
 
 	xe_device_wmb(vm->xe);
 
+#ifdef BPM_MMU_INTERVAL_NOTIFIER_TWOPASS_NOT_PRESENT
+	return xe_vm_range_tilemask_tlb_inval(vm, start, end, tile_mask);
+#else
 	err = xe_tlb_inval_range_tilemask_submit(vm->xe, vm->usm.asid, start, end,
 						 tile_mask, &batch);
 	if (!err)
 		xe_tlb_inval_batch_wait(&batch);
 
 	return err;
+#endif
+
 }
 
 static bool madvise_args_are_sane(struct xe_device *xe, const struct drm_xe_madvise *args)
