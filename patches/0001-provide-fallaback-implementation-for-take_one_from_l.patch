From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Akanksha Hotta <akanksha.hotta@intel.com>
Date: Tue, 14 Jul 2026 15:38:55 +0530
Subject: provide fallaback implementation for take_one_from_lru() and
 pool_move_to_dispose_list()

When the struct spinlock * parameter is removed from the
list_lru_walk_cb callback type from mainline kernel. On older kernels, the
spinlock parameter is still expected.

Add BPM_LIST_LRU_WALK_CB_PARAM_NOT_PRESENT guards around the spinlock
parameter in take_one_from_lru() and pool_move_to_dispose_list()
callbacks to fix incompatible pointer type build errors on kernels that
still carry the spinlock in list_lru_walk_cb.

Reference:
   da0c02516c50
   mm/list_lru: simplify the list_lru walk callback function

Signed-off-by: Akanksha Hotta <akanksha.hotta@intel.com>
---
 drivers/gpu/drm/ttm/ttm_pool.c | 22 ++++++++++++++++++----
 1 file changed, 18 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/ttm/ttm_pool.c b/drivers/gpu/drm/ttm/ttm_pool.c
index 3b2034f..a3faf4e 100644
--- a/drivers/gpu/drm/ttm/ttm_pool.c
+++ b/drivers/gpu/drm/ttm/ttm_pool.c
@@ -344,9 +344,16 @@ static void ttm_pool_type_give(struct ttm_pool_type *pt, struct page *p)
 #endif
 }
 
+#ifdef BPM_LIST_LRU_WALK_CB_PARAM_NOT_PRESENT
 static enum lru_status take_one_from_lru(struct list_head *item,
-					 struct list_lru_one *list,
-					 void *cb_arg)
+					struct list_lru_one *list,
+					spinlock_t *lock,
+					void *cb_arg)
+#else
+static enum lru_status take_one_from_lru(struct list_head *item,
+					struct list_lru_one *list,
+					void *cb_arg)
+#endif
 {
 	struct page **out_page = cb_arg;
 	struct page *p = container_of(item, struct page, lru);
@@ -388,9 +395,16 @@ static void ttm_pool_type_init(struct ttm_pool_type *pt, struct ttm_pool *pool,
 	spin_unlock(&shrinker_lock);
 }
 
+#ifdef BPM_LIST_LRU_WALK_CB_PARAM_NOT_PRESENT
 static enum lru_status pool_move_to_dispose_list(struct list_head *item,
-						 struct list_lru_one *list,
-						 void *cb_arg)
+						struct list_lru_one *list,
+						spinlock_t *lock,
+						void *cb_arg)
+#else
+static enum lru_status pool_move_to_dispose_list(struct list_head *item,
+						struct list_lru_one *list,
+						void *cb_arg)
+#endif
 {
 	struct list_head *dispose = cb_arg;
 
