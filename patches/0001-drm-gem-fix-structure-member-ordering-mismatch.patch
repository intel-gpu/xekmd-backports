From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pravalika Gurram <pravalika.gurram@intel.com>
Date: Thu, 8 Oct 2026 20:42:04 +0530
Subject: drm/gem: fix structure member ordering mismatch

New members added to drm_gem_object_funcs in the backport lead to
misalignment.

Fix by probing whether the kernel struct has those members, and excluding
them from the backport when absent.

Signed-off-by: Pravalika Gurram <pravalika.gurram@intel.com>
---
 include/drm/drm_gem.h | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/include/drm/drm_gem.h b/include/drm/drm_gem.h
index 6ac452d..fb94945 100644
--- a/include/drm/drm_gem.h
+++ b/include/drm/drm_gem.h
@@ -194,6 +194,7 @@ struct drm_gem_object_funcs {
 	 */
 	int (*mmap)(struct drm_gem_object *obj, struct vm_area_struct *vma);
 
+#ifndef BPM_DRM_GEM_OBJECT_FUNCS_EVICT_NOT_PRESENT
 	/**
 	 * @evict:
 	 *
@@ -204,7 +205,9 @@ struct drm_gem_object_funcs {
 	 * This callback is optional.
 	 */
 	int (*evict)(struct drm_gem_object *obj);
+#endif
 
+#ifndef BPM_DRM_GEM_OBJECT_FUNCS_STATUS_NOT_PRESENT
 	/**
 	 * @status:
 	 *
@@ -217,7 +220,9 @@ struct drm_gem_object_funcs {
 	 * Called by drm_show_memory_stats().
 	 */
 	enum drm_gem_object_status (*status)(struct drm_gem_object *obj);
+#endif
 
+#ifndef BPM_DRM_GEM_OBJECT_FUNCS_RSS_NOT_PRESENT
 	/**
 	 * @rss:
 	 *
@@ -226,6 +231,7 @@ struct drm_gem_object_funcs {
 	 * Called by drm_show_memory_stats().
 	 */
 	size_t (*rss)(struct drm_gem_object *obj);
+#endif
 
 	/**
 	 * @vm_ops:
-- 
