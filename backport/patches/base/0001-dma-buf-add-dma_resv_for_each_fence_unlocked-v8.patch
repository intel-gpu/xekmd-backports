 #define dma_resv_held(obj) lockdep_is_held(&(obj)->lock.base)
 #define dma_resv_assert_held(obj) lockdep_assert_held(&(obj)->lock.base)
 
@@ -396,6 +301,93 @@ static inline int dma_resv_reserve_fences(struct dma_resv *obj,
 	return dma_resv_reserve_shared(obj, num_fences);
 }
 
+/**
+ * struct dma_resv_iter - current position into the dma_resv object
+ * @obj: the dma_resv object this iterator walks
+ * @usage: the usage filter; fences weaker than this are skipped
+ * @fence: the currently handled fence
+ * @fence_usage: the usage of the current fence
+ * @index: index into the shared[] array, -1 means exclusive fence has
+ *         not been returned yet
+ * @shared_count: number of shared[] entries sampled at restart time
+ * @seq: sequence number to check for modifications
+ * @fobj: the shared fences sampled at restart time
+ * @is_restarted: true if this is the first fence after a restart
+ */
+struct dma_resv_iter {
+	struct dma_resv *obj;
+	enum dma_resv_usage usage;
+	struct dma_fence *fence;
+	enum dma_resv_usage fence_usage;
+	int index;
+	unsigned int shared_count;
+	unsigned int seq;
+	struct dma_resv_list *fobj;
+	bool is_restarted;
+};
+
+#define dma_resv_for_each_fence_unlocked(cursor, fence) \
+    for (fence = dma_resv_iter_first_unlocked(cursor); \
+         fence; fence = dma_resv_iter_next_unlocked(cursor))
+
+#define dma_resv_for_each_fence(cursor, obj, usage, fence) \
+    for (dma_resv_iter_begin(cursor, obj, usage), \
+         fence = dma_resv_iter_first(cursor); fence; \
+         fence = dma_resv_iter_next(cursor))
+
+/**
+ * dma_resv_iter_begin - initialize a dma_resv_iter object
+ * @cursor: The dma_resv_iter object to initialize
+ * @obj: The dma_resv object which we want to iterate over
+ * @usage: controls which fences to include, see enum dma_resv_usage.
+ */
+static inline void dma_resv_iter_begin(struct dma_resv_iter *cursor,
+				       struct dma_resv *obj,
+				       enum dma_resv_usage usage)
+{
+	cursor->obj = obj;
+	cursor->usage = usage;
+	cursor->fence = NULL;
+	cursor->fence_usage = DMA_RESV_USAGE_KERNEL;
+	cursor->fobj = NULL;
+	cursor->shared_count = 0;
+	cursor->index = 0;
+	cursor->seq = 0;
+	cursor->is_restarted = false;
+}
+
+static inline void dma_resv_iter_end(struct dma_resv_iter *cursor)
+{
+	/* RCU is no longer held across the loop, so just drop the fence ref */
+	if (cursor->fence) {
+		dma_fence_put(cursor->fence);
+		cursor->fence = NULL;
+	}
+}
+
+static inline bool dma_resv_iter_is_exclusive(struct dma_resv_iter *cursor)
+{
+	return cursor->index == 0;
+}
+
+/**
+ * dma_resv_iter_is_restarted - test if this is the first fence after a restart
+ * @cursor: the cursor with the current position
+ *
+ * Callers which accumulate fences into an array MUST discard what they have
+ * collected so far when this returns true, otherwise a concurrent writer can
+ * make them collect duplicates and unbalance the fence refcounts.
+ */
+static inline bool dma_resv_iter_is_restarted(struct dma_resv_iter *cursor)
+{
+	return cursor->is_restarted;
+}
+
+struct dma_fence *dma_resv_iter_first_unlocked(struct dma_resv_iter *cursor);
+struct dma_fence *dma_resv_iter_next_unlocked(struct dma_resv_iter *cursor);
+struct dma_fence *dma_resv_iter_first(struct dma_resv_iter *cursor);
+struct dma_fence *dma_resv_iter_next(struct dma_resv_iter *cursor);
+
 void dma_resv_add_fence(struct dma_resv *obj, struct dma_fence *fence, enum dma_resv_usage usage);
 
 #endif /* _LINUX_RESERVATION_H */
