From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Christian=20K=C3=B6nig?= <christian.koenig@amd.com>
Date: Tue, 9 Nov 2021 11:08:18 +0100
Subject: dma-buf: specify usage while adding fences to dma_resv obj v7

Instead of distingting between shared and exclusive fences specify
the fence usage while adding fences.

Rework all drivers to use this interface instead and deprecate the old one.

v2: some kerneldoc comments suggested by Daniel
v3: fix a missing case in radeon
v4: rebase on nouveau changes, fix lockdep and temporary disable warning
v5: more documentation updates
v6: separate internal dma_resv changes from this patch, avoids to
    disable warning temporary, rebase on upstream changes
v7: fix missed case in lima driver, minimize changes to i915_gem_busy_ioctl

Signed-off-by: Christian König <christian.koenig@amd.com>
Reviewed-by: Daniel Vetter <daniel.vetter@ffwll.ch>
Link: https://patchwork.freedesktop.org/patch/msgid/20220407085946.744568-3-christian.koenig@amd.com

(Backported from commit 73511edf8b196e6f1ccda0fdf294ff57aa2dc9db linux)

Reviewed-by: Arvind Yadav <arvind.yadav@intel.com>
Signed-off-by: Varun Gupta <varun.gupta@intel.com>
---
 drivers/dma-buf/dma-resv.c | 90 +++++++++++++++++++++++++++++++++-----
 include/linux/dma-resv.h   |  2 +
 2 files changed, 82 insertions(+), 10 deletions(-)

diff --git a/drivers/dma-buf/dma-resv.c b/drivers/dma-buf/dma-resv.c
index 67da04653311..40590722336c 100644
--- a/drivers/dma-buf/dma-resv.c
+++ b/drivers/dma-buf/dma-resv.c
@@ -270,14 +270,17 @@ EXPORT_SYMBOL(dma_resv_reset_shared_max);
 #endif
 
 /**
- * dma_resv_add_shared_fence - Add a fence to a shared slot
+ * __dma_resv_add_shared_fence - add a fence to a shared slot with a usage tag
  * @obj: the reservation object
- * @fence: the shared fence to add
+ * @fence: the fence to add
+ * @usage: the usage encoded into the slot, see DMA_RESV_LIST_MASK
  *
- * Add a fence to a shared slot, obj->lock must be held, and
- * dma_resv_reserve_shared() has been called.
+ * obj->lock must be held and a slot must have been reserved with
+ * dma_resv_reserve_shared().
  */
-void dma_resv_add_shared_fence(struct dma_resv *obj, struct dma_fence *fence)
+static void __dma_resv_add_shared_fence(struct dma_resv *obj,
+					struct dma_fence *fence,
+					enum dma_resv_usage usage)
 {
 	struct dma_resv_list *fobj;
 	struct dma_fence *old;
@@ -293,10 +296,11 @@ void dma_resv_add_shared_fence(struct dma_resv *obj, struct dma_fence *fence)
 	write_seqcount_begin(&obj->seq);
 
 	for (i = 0; i < count; ++i) {
+		enum dma_resv_usage old_usage;
 
-		old = rcu_dereference_protected(fobj->shared[i],
-						dma_resv_held(obj));
-		if (old->context == fence->context ||
+		dma_resv_list_entry(fobj, i, obj, &old, &old_usage);
+		if ((old->context == fence->context && old_usage >= usage &&
+		     (old == fence || dma_fence_is_later(fence, old))) ||
 		    dma_fence_is_signaled(old))
 			goto replace;
 	}
@@ -306,14 +310,35 @@ void dma_resv_add_shared_fence(struct dma_resv *obj, struct dma_fence *fence)
 	count++;
 
 replace:
-	RCU_INIT_POINTER(fobj->shared[i], fence);
-	/* fence update must be visible before we extend the shared_count */
+	dma_resv_list_set(fobj, i, fence, usage);
+	/*
+	 * The tagged slot store must be visible before shared_count grows,
+	 * otherwise a lockless reader can observe the new count and then load
+	 * a stale or uninitialised slot. WRITE_ONCE() additionally stops the
+	 * compiler tearing or sinking the update past the seqcount close.
+	 */
 	smp_wmb();
 	fobj->shared_count = count;
 
 	write_seqcount_end(&obj->seq);
 	dma_fence_put(old);
 }
+
+/**
+ * dma_resv_add_shared_fence - Add a fence to a shared slot
+ * @obj: the reservation object
+ * @fence: the shared fence to add
+ *
+ * Add a fence to a shared slot, obj->lock must be held, and
+ * dma_resv_reserve_shared() has been called.
+ *
+ * Legacy 5.15 entry point. Upstream commit 73511edf8b19 converted these
+ * callers to DMA_RESV_USAGE_READ, so tag the slot accordingly.
+ */
+void dma_resv_add_shared_fence(struct dma_resv *obj, struct dma_fence *fence)
+{
+	__dma_resv_add_shared_fence(obj, fence, DMA_RESV_USAGE_READ);
+}
 EXPORT_SYMBOL(dma_resv_add_shared_fence);
 
 /**
@@ -790,3 +815,48 @@ static int __init dma_resv_lockdep(void)
 }
 subsys_initcall(dma_resv_lockdep);
 #endif
+
+/**
+ * dma_resv_add_fence - add a fence to the dma_resv object
+ * @obj: the reservation object
+ * @fence: the fence to add
+ * @usage: how the fence is used, see enum dma_resv_usage
+ *
+ * Add a fence to the reservation object with a specific usage tag.
+ * obj->lock must be held, and dma_resv_reserve_fences() must have been
+ * called prior to adding the fence.
+ */
+void dma_resv_add_fence(struct dma_resv *obj, struct dma_fence *fence, enum dma_resv_usage usage)
+{
+	struct dma_resv_list *fobj;
+
+	dma_resv_assert_held(obj);
+
+	if (WARN_ON(!fence))
+		return;
+
+	/*
+	 * dma_resv_add_shared_fence() BUG()s when no slot was reserved. Modern
+	 * callers must call dma_resv_reserve_fences() first, but grow the list
+	 * here rather than crashing the machine if one of them forgot.
+	 */
+	fobj = dma_resv_shared_list(obj);
+	if (!fobj || fobj->shared_count >= fobj->shared_max) {
+		int err = dma_resv_reserve_shared(obj, 1);
+
+		if (err) {
+			/*
+			 * Dropping the fence here means the caller believes the
+			 * BO is protected when it is not, which lets eviction or
+			 * free race the GPU. Make it impossible to miss.
+			 */
+			pr_err("dma_resv: DROPPED fence %llu:%llu usage=%d on obj %p, reserve failed (%d)\n",
+			       fence->context, fence->seqno, usage, obj, err);
+			WARN_ON(1);
+			return;
+		}
+	}
+
+	__dma_resv_add_shared_fence(obj, fence, usage);
+}
+EXPORT_SYMBOL(dma_resv_add_fence);
diff --git a/include/linux/dma-resv.h b/include/linux/dma-resv.h
index 4edff7e44f82..f459c7224ba8 100644
--- a/include/linux/dma-resv.h
+++ b/include/linux/dma-resv.h
@@ -396,4 +396,6 @@ static inline int dma_resv_reserve_fences(struct dma_resv *obj,
 	return dma_resv_reserve_shared(obj, num_fences);
 }
 
+void dma_resv_add_fence(struct dma_resv *obj, struct dma_fence *fence, enum dma_resv_usage usage);
+
 #endif /* _LINUX_RESERVATION_H */
-- 
