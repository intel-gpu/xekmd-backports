From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kanaka Raju Nayana <kanaka.raju.nayana@intel.com>
Date: Wed, 2 Sep 2026 20:09:40 +0530
Subject: drm/drm_ras: parse error counter doit attributes

drm_ras validates required attributes in single-request counter
handlers. Older kernels do not provide those attributes through
the handler context, which causes valid YNL counter requests to fail.

Parse the request attributes from the Netlink message when
needed so the single-counter get and clear commands can
validate their input.

Signed-off-by: Kanaka Raju Nayana <kanaka.raju.nayana@intel.com>
---
 drivers/gpu/drm/drm_ras.c | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/drivers/gpu/drm/drm_ras.c b/drivers/gpu/drm/drm_ras.c
index b9fb03f..4040a23 100644
--- a/drivers/gpu/drm/drm_ras.c
+++ b/drivers/gpu/drm/drm_ras.c
@@ -568,6 +568,7 @@ int drm_ras_nl_get_error_counter_doit(struct sk_buff *skb,
 {
 	u32 node_id, error_id;
 
+#ifndef BPM_GENL_SPLIT_OPS_NOT_PRESENT
 	if (!info->attrs ||
 	    GENL_REQ_ATTR_CHECK(info, DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID) ||
 	    GENL_REQ_ATTR_CHECK(info, DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID))
@@ -575,6 +576,21 @@ int drm_ras_nl_get_error_counter_doit(struct sk_buff *skb,
 
 	node_id = nla_get_u32(info->attrs[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID]);
 	error_id = nla_get_u32(info->attrs[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID]);
+#else
+	struct nlattr *tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID + 1];
+
+	if (genlmsg_parse(info->nlhdr, &drm_ras_nl_family, tb,
+			  DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID, NULL,
+			  info->extack))
+		return -EINVAL;
+
+	if (!tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID] ||
+	    !tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID])
+		return -EINVAL;
+
+	node_id = nla_get_u32(tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID]);
+	error_id = nla_get_u32(tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID]);
+#endif
 
 	return doit_reply_value(info, node_id, error_id);
 }
@@ -595,6 +611,7 @@ int drm_ras_nl_clear_error_counter_doit(struct sk_buff *skb,
 	struct drm_ras_node *node;
 	u32 node_id, error_id;
 
+#ifndef BPM_GENL_SPLIT_OPS_NOT_PRESENT
 	if (!info->attrs ||
 	    GENL_REQ_ATTR_CHECK(info, DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID) ||
 	    GENL_REQ_ATTR_CHECK(info, DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID))
@@ -602,6 +619,21 @@ int drm_ras_nl_clear_error_counter_doit(struct sk_buff *skb,
 
 	node_id = nla_get_u32(info->attrs[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID]);
 	error_id = nla_get_u32(info->attrs[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID]);
+#else
+	struct nlattr *tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID + 1];
+
+	if (genlmsg_parse(info->nlhdr, &drm_ras_nl_family, tb,
+			  DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID, NULL,
+			  info->extack))
+		return -EINVAL;
+
+	if (!tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID] ||
+	    !tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID])
+		return -EINVAL;
+
+	node_id = nla_get_u32(tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_NODE_ID]);
+	error_id = nla_get_u32(tb[DRM_RAS_A_ERROR_COUNTER_ATTRS_ERROR_ID]);
+#endif
 
 	node = xa_load(&drm_ras_xa, node_id);
 	if (!node || !node->clear_error_counter)
-- 
