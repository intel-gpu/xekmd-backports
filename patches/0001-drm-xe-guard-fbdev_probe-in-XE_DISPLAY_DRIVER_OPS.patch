From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rachapalli Bandi Jagadeesh <jagadeesh.rachapalli.bandi@intel.com>
Date: Wed, 27 Aug 2026 00:00:00 +0530
Subject: drm/xe: guard XE_DISPLAY_DRIVER_OPS .fbdev_probe

struct drm_driver gained the ->fbdev_probe member upstream in v6.12
(5d08c44e47b9). On older kernels the copied xe_display.h fails to build with:

Error:
---------------------------------------------------------------------------
error: 'const struct drm_driver' has no member named 'fbdev_probe'
---------------------------------------------------------------------------

Gate both XE_DISPLAY_DRIVER_OPS variants on
BPM_DRM_DRIVER_FBDEV_PROBE_NOT_PRESENT so kernels that don't
ship .fbdev_probe just expand XE_DISPLAY_DRIVER_OPS to nothing.

Signed-off-by: Rachapalli Bandi Jagadeesh <jagadeesh.rachapalli.bandi@intel.com>
---
 drivers/gpu/drm/xe/display/xe_display.h | 10 ++++++++++
 drivers/gpu/drm/xe/xe_device.c          |  2 +-
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/xe/display/xe_display.h b/drivers/gpu/drm/xe/display/xe_display.h
--- a/drivers/gpu/drm/xe/display/xe_display.h
+++ b/drivers/gpu/drm/xe/display/xe_display.h
@@ -46,14 +46,22 @@ void xe_display_pm_runtime_resume(struct xe_device *xe);
 
 #define XE_DISPLAY_DRIVER_FEATURES	(DRIVER_MODESET | DRIVER_ATOMIC)
+#ifdef BPM_DRM_DRIVER_FBDEV_PROBE_NOT_PRESENT
+#define XE_DISPLAY_DRIVER_OPS
+#else
 #define XE_DISPLAY_DRIVER_OPS						\
 	.fbdev_probe = PTR_IF(IS_ENABLED(CONFIG_DRM_FBDEV_EMULATION),	\
 			      xe_display_driver_fbdev_probe)
+#endif
 
 #else
 
 #define XE_DISPLAY_DRIVER_FEATURES	0
+#ifdef BPM_DRM_DRIVER_FBDEV_PROBE_NOT_PRESENT
+#define XE_DISPLAY_DRIVER_OPS
+#else
 #define XE_DISPLAY_DRIVER_OPS \
 	.fbdev_probe = NULL
+#endif
 
 static inline int xe_display_driver_probe_defer(struct pci_dev *pdev) { return 0; }
 
diff --git a/drivers/gpu/drm/xe/xe_device.c b/drivers/gpu/drm/xe/xe_device.c
--- a/drivers/gpu/drm/xe/xe_device.c
+++ b/drivers/gpu/drm/xe/xe_device.c
@@ -442,7 +442,7 @@
 	.major = DRIVER_MAJOR,
 	.minor = DRIVER_MINOR,
 	.patchlevel = DRIVER_PATCHLEVEL,
-	XE_DISPLAY_DRIVER_OPS,
+	XE_DISPLAY_DRIVER_OPS
 };
 
 #ifdef CONFIG_PCI_IOV
