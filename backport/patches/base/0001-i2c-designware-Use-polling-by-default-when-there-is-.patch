From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Heikki Krogerus <heikki.krogerus@linux.intel.com>
Date: Wed, 30 Sep 2026 11:45:55 +0530
Subject: i2c: designware: Use polling by default when there is no irq
 resource

The Intel Xe I2C host controller is registered as a platform device by the
xe driver without an interrupt resource, because its interrupt line is not
wired up on that platform. On velinux 5.15 dw_i2c_plat_probe() calls
platform_get_irq(), which fails with -ENXIO and aborts the probe with:

  i2c_designware i2c_designware.768: IRQ index 0 not found

Switch to platform_get_irq_optional() and, when no interrupt resource is
present, fall back to the generic polling transfer mode by setting
ACCESS_POLLING instead of failing. i2c_dw_probe_master() then skips
devm_request_irq() for polling-mode controllers.

Signed-off-by: Heikki Krogerus heikki.krogerus@linux.intel.com
Link: https://lore.kernel.org/r/20250701122252.2590230-2-heikki.krogerus@linux.intel.com
(backported from 22290cc904d9f5b882748573a16ccf8c6d632d92)
Signed-off-by: Nitin Gote nitin.r.gote@intel.com
---
 drivers/i2c/busses/i2c-designware-master.c  | 25 +++++++++++----------
 drivers/i2c/busses/i2c-designware-platdrv.c |  6 +++--
 2 files changed, 17 insertions(+), 14 deletions(-)

diff --git a/drivers/i2c/busses/i2c-designware-master.c b/drivers/i2c/busses/i2c-designware-master.c
index de1418b5c..e28a72859 100644
--- a/drivers/i2c/busses/i2c-designware-master.c
+++ b/drivers/i2c/busses/i2c-designware-master.c
@@ -969,19 +969,20 @@ int i2c_dw_probe_master(struct dw_i2c_dev *dev)
 	if ((dev->flags & MODEL_MASK) == MODEL_AMD_NAVI_GPU)
 		return amd_i2c_adap_quirk(dev);
 
-	if (dev->flags & ACCESS_NO_IRQ_SUSPEND) {
-		irq_flags = IRQF_NO_SUSPEND;
-	} else {
-		irq_flags = IRQF_SHARED | IRQF_COND_SUSPEND;
-	}
-
 	i2c_dw_disable_int(dev);
-	ret = devm_request_irq(dev->dev, dev->irq, i2c_dw_isr, irq_flags,
-			       dev_name(dev->dev), dev);
-	if (ret) {
-		dev_err(dev->dev, "failure requesting irq %i: %d\n",
-			dev->irq, ret);
-		return ret;
+	if (!(dev->flags & ACCESS_POLLING)) {
+		if (dev->flags & ACCESS_NO_IRQ_SUSPEND)
+			irq_flags = IRQF_NO_SUSPEND;
+		else
+			irq_flags = IRQF_SHARED | IRQF_COND_SUSPEND;
+
+		ret = devm_request_irq(dev->dev, dev->irq, i2c_dw_isr, irq_flags,
+				       dev_name(dev->dev), dev);
+		if (ret) {
+			dev_err(dev->dev, "failure requesting irq %i: %d\n",
+				dev->irq, ret);
+			return ret;
+		}
 	}
 
 	ret = i2c_dw_init_recovery_info(dev);
diff --git a/drivers/i2c/busses/i2c-designware-platdrv.c b/drivers/i2c/busses/i2c-designware-platdrv.c
index 09fcd155c..0868fd633 100644
--- a/drivers/i2c/busses/i2c-designware-platdrv.c
+++ b/drivers/i2c/busses/i2c-designware-platdrv.c
@@ -211,8 +211,8 @@ static int dw_i2c_plat_probe(struct platform_device *pdev)
 	struct i2c_timings *t;
 	int irq, ret;
 
-	irq = platform_get_irq(pdev, 0);
-	if (irq < 0)
+	irq = platform_get_irq_optional(pdev, 0);
+	if (irq < 0 && irq != -ENXIO)
 		return irq;
 
 	dev = devm_kzalloc(&pdev->dev, sizeof(struct dw_i2c_dev), GFP_KERNEL);
@@ -220,6 +220,8 @@ static int dw_i2c_plat_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	dev->flags = (uintptr_t)device_get_match_data(&pdev->dev);
+	if (irq == -ENXIO)
+		dev->flags |= ACCESS_POLLING;
 	dev->dev = &pdev->dev;
 	dev->irq = irq;
 	platform_set_drvdata(pdev, dev);
-- 
2.50.1

