From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kanaka Raju Nayana <kanaka.raju.nayana@intel.com>
Date: Tue, 1 Sep 2026 03:20:38 +0530
Subject: drm/drm_ras: Add DRM RAS Generic Netlink reply helper

drm_ras uses a generic netlink reply helper while building command
replies. older kernels do not provide this helper, which causes
drm_ras compilation to fail.

Add compatibility handling for the missing reply helper so drm_ras
can build and use the older reply construction path where needed.

Signed-off-by: Kanaka Raju Nayana <kanaka.raju.nayana@intel.com>
---
 drivers/gpu/drm/drm_ras.c | 34 +++++++++++++++++++++++++++++++++-
 1 file changed, 33 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/drm_ras.c b/drivers/gpu/drm/drm_ras.c
index b8a65f4..b9fb03f 100644
--- a/drivers/gpu/drm/drm_ras.c
+++ b/drivers/gpu/drm/drm_ras.c
@@ -135,7 +135,13 @@ int drm_ras_nl_list_nodes_dumpit(struct sk_buff *skb,
 	int ret;
 
 	xa_for_each_start(&drm_ras_xa, id, node, ctx->restart) {
+#ifdef BPM_GENLMSG_IPUT_NOT_PRESENT
+		hdr = genlmsg_put(skb, NETLINK_CB(cb->skb).portid,
+				  cb->nlh->nlmsg_seq, &drm_ras_nl_family,
+				  0, DRM_RAS_CMD_LIST_NODES);
+#else
 		hdr = genlmsg_iput(skb, info);
+#endif
 		if (!hdr) {
 			ret = -EMSGSIZE;
 			break;
@@ -302,7 +308,13 @@ static int doit_reply_value(struct genl_info *info, u32 node_id,
 	if (!msg)
 		return -ENOMEM;
 
+#ifdef BPM_GENLMSG_IPUT_NOT_PRESENT
+	hdr = genlmsg_put(msg, info->snd_portid, info->snd_seq,
+			  &drm_ras_nl_family, 0,
+			  info->genlhdr->cmd);
+#else
 	hdr = genlmsg_iput(msg, info);
+#endif
 	if (!hdr) {
 		ret = -EMSGSIZE;
 		goto free_msg;
@@ -340,7 +352,13 @@ static int doit_reply_threshold(struct genl_info *info, u32 node_id, u32 error_i
 	if (!msg)
 		return -ENOMEM;
 
+#ifdef BPM_GENLMSG_IPUT_NOT_PRESENT
+	hdr = genlmsg_put(msg, info->snd_portid, info->snd_seq,
+			  &drm_ras_nl_family, 0,
+			  info->genlhdr->cmd);
+#else
 	hdr = genlmsg_iput(msg, info);
+#endif
 	if (!hdr) {
 		ret = -EMSGSIZE;
 		goto free_msg;
@@ -383,7 +401,9 @@ free_msg:
 int drm_ras_nl_error_event(struct drm_ras_node *node, u32 error_id, const char *error_name,
 			   u32 value)
 {
+#ifndef BPM_GENLMSG_IPUT_NOT_PRESENT
 	struct genl_info info;
+#endif
 	struct sk_buff *msg;
 	struct nlattr *hdr;
 	int ret;
@@ -404,13 +424,20 @@ int drm_ras_nl_error_event(struct drm_ras_node *node, u32 error_id, const char *
 	    error_id > node->error_counter_range.last)
 		return -EINVAL;
 
+#ifndef BPM_GENLMSG_IPUT_NOT_PRESENT
 	genl_info_init_ntf(&info, &drm_ras_nl_family, DRM_RAS_CMD_ERROR_EVENT);
+#endif
 
 	msg = genlmsg_new(NLMSG_GOODSIZE, GFP_KERNEL);
 	if (!msg)
 		return -ENOMEM;
 
+#ifdef BPM_GENLMSG_IPUT_NOT_PRESENT
+	hdr = genlmsg_put(msg, 0, 0, &drm_ras_nl_family, 0,
+			  DRM_RAS_CMD_ERROR_EVENT);
+#else
 	hdr = genlmsg_iput(msg, &info);
+#endif
 	if (!hdr) {
 		ret = -EMSGSIZE;
 		goto free_msg;
@@ -497,8 +524,13 @@ int drm_ras_nl_get_error_counter_dumpit(struct sk_buff *skb,
 			continue;
 		if (ret)
 			return ret;
-
+#ifdef BPM_GENLMSG_IPUT_NOT_PRESENT
+		hdr = genlmsg_put(skb, NETLINK_CB(cb->skb).portid,
+				  cb->nlh->nlmsg_seq, &drm_ras_nl_family,
+				  0, DRM_RAS_CMD_GET_ERROR_COUNTER);
+#else
 		hdr = genlmsg_iput(skb, info);
+#endif
 
 		if (!hdr) {
 			ret = -EMSGSIZE;
-- 
2.43.0
