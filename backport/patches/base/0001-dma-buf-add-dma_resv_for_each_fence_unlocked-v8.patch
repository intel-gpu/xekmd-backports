+/**
+ * dma_resv_iter_restart_unlocked - restart the unlocked iterator
+ * @cursor: The dma_resv_iter object to restart
+ *
+ * Restart the unlocked iteration by initializing the cursor object.
+ * @index == -1 encodes that the exclusive fence has not been produced yet.
+ * Must be called under rcu_read_lock().
+ */
+static void dma_resv_iter_restart_unlocked(struct dma_resv_iter *cursor)
+{
+	cursor->seq = read_seqcount_begin(&cursor->obj->seq);
+	cursor->index = -1;
+	cursor->shared_count = 0;
+	cursor->fobj = rcu_dereference(cursor->obj->fence);
+	if (cursor->fobj)
+		cursor->shared_count = READ_ONCE(cursor->fobj->shared_count);
+	cursor->is_restarted = true;
+}
+
+/*
+ * Walk to the next fence, skipping signaled fences and fences whose usage is
+ * weaker than requested. Must be called under rcu_read_lock().
+ *
+ * On return @cursor->fence is either NULL or holds a reference. Note that this
+ * function only ever leaves its own loop; the seqcount is re-validated by the
+ * caller, which is what makes a concurrent list update force a restart instead
+ * of being mistaken for the end of the iteration.
+ */
+static void dma_resv_iter_walk_unlocked(struct dma_resv_iter *cursor)
+{
+	struct dma_resv *obj = cursor->obj;
+	struct dma_fence *fence;
+
+	do {
+		/* Drop the reference from the previous round */
+		dma_fence_put(cursor->fence);
+		cursor->fence = NULL;
+
+		if (cursor->index == -1) {
+			/*
+			 * The exclusive fence is produced for every @usage on
+			 * purpose: it is never a preempt fence (those are tagged
+			 * DMA_RESV_USAGE_BOOKKEEP in shared[]), so including it
+			 * can only over-synchronise, never deadlock.
+			 */
+			fence = rcu_dereference(obj->fence_excl);
+			cursor->fence_usage = DMA_RESV_USAGE_WRITE;
+			cursor->index++;
+			if (!fence)
+				continue;
+		} else if (!cursor->fobj ||
+			   cursor->index >= (int)cursor->shared_count) {
+			break;
+		} else {
+			enum dma_resv_usage usage;
+
+			dma_resv_list_entry(cursor->fobj, cursor->index++, NULL,
+					    &fence, &usage);
+			if (usage > cursor->usage) {
+				continue;
+			}
+			cursor->fence_usage = usage;
+		}
+
+		fence = dma_fence_get_rcu(fence);
+		if (!fence) {
+			/* The fence is being freed under us, start over */
+			pr_warn_ratelimited("dma_resv: iter restart, fence freed under RCU, obj %p idx %d\n",
+					    obj, cursor->index - 1);
+			dma_resv_iter_restart_unlocked(cursor);
+			continue;
+		}
+
+		cursor->fence = fence;
+		if (!dma_fence_is_signaled(fence))
+			break;
+	} while (true);
+}
+
+struct dma_fence *dma_resv_iter_first_unlocked(struct dma_resv_iter *cursor)
+{
+	rcu_read_lock();
+	do {
+		dma_resv_iter_restart_unlocked(cursor);
+		dma_resv_iter_walk_unlocked(cursor);
+	} while (read_seqcount_retry(&cursor->obj->seq, cursor->seq));
+	rcu_read_unlock();
+
+	return cursor->fence;
+}
+EXPORT_SYMBOL(dma_resv_iter_first_unlocked);
+
+struct dma_fence *dma_resv_iter_next_unlocked(struct dma_resv_iter *cursor)
+{
+	bool restart;
+
+	rcu_read_lock();
+	cursor->is_restarted = false;
+	restart = read_seqcount_retry(&cursor->obj->seq, cursor->seq);
+	do {
+		if (restart)
+			dma_resv_iter_restart_unlocked(cursor);
+		dma_resv_iter_walk_unlocked(cursor);
+		restart = true;
+	} while (read_seqcount_retry(&cursor->obj->seq, cursor->seq));
+	rcu_read_unlock();
+
+	return cursor->fence;
+}
+EXPORT_SYMBOL(dma_resv_iter_next_unlocked);
