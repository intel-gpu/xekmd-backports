 Documentation/gpu/xe/xe_device.rst            |   7 +
 drivers/gpu/drm/xe/xe_ras.c                   | 153 ++++++++++++++++++
 drivers/gpu/drm/xe/xe_ras_types.h             |  42 +++++
 drivers/gpu/drm/xe/xe_sysctrl_mailbox_types.h |   4 +
