From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Akanksha Hotta <akanksha.hotta@intel.com>
Date: Mon, 29 Jun 2026 18:34:09 +0530
Subject: drm/ttm: adapt list_lru_walk callbacks across kernel signatures

Signed-off-by: Akanksha Hotta <akanksha.hotta@intel.com>
---
 drivers/gpu/drm/ttm/ttm_pool.c | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/ttm/ttm_pool.c b/drivers/gpu/drm/ttm/ttm_pool.c
index 8b638a1..bc12652 100644
--- a/drivers/gpu/drm/ttm/ttm_pool.c
+++ b/drivers/gpu/drm/ttm/ttm_pool.c
@@ -344,9 +344,7 @@ static void ttm_pool_type_give(struct ttm_pool_type *pt, struct page *p)
 #endif
 }
 
-static enum lru_status take_one_from_lru(struct list_head *item,
-					 struct list_lru_one *list,
-					 void *cb_arg)
+LIST_LRU_WALK_CALLBACK(take_one_from_lru)
 {
 	struct page **out_page = cb_arg;
 	struct page *p = container_of(item, struct page, lru);
@@ -388,9 +386,7 @@ static void ttm_pool_type_init(struct ttm_pool_type *pt, struct ttm_pool *pool,
 	spin_unlock(&shrinker_lock);
 }
 
-static enum lru_status pool_move_to_dispose_list(struct list_head *item,
-						 struct list_lru_one *list,
-						 void *cb_arg)
+LIST_LRU_WALK_CALLBACK(pool_move_to_dispose_list)
 {
 	struct list_head *dispose = cb_arg;
 
