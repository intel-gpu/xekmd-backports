From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Varun Gupta <varun.gupta1@intel.com>
Date: Tue, 26 May 2026 11:52:40 +0530
Subject: drm/pagemap: Gate shrinker eviction when migrate_device_pfns unavailable

Signed-off-by: Varun Gupta <varun.gupta@intel.com>
---
 drivers/gpu/drm/drm_pagemap.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/drm_pagemap.c b/drivers/gpu/drm/drm_pagemap.c
index 53f8fcf..0f7e68a 100644
--- a/drivers/gpu/drm/drm_pagemap.c
+++ b/drivers/gpu/drm/drm_pagemap.c
@@ -981,10 +981,14 @@ retry:
 	if (err)
 		goto err_free;
 
+#ifdef BPM_MIGRATE_DEVICE_PFNS_NOT_PRESENT
+	err = -EOPNOTSUPP;
+	goto err_free;
+#else
 	err = migrate_device_pfns(src, npages);
 	if (err)
 		goto err_free;
-
+#endif
 	err = drm_pagemap_migrate_populate_ram_pfn(NULL, NULL, npages, &mpages,
 						   src, dst, 0);
 	if (err || !mpages)
-- 
