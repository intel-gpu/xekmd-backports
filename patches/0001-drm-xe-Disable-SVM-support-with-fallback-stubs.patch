From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Akanksha Hotta <akanksha.hotta@intel.com>
Date: Tue, 9 Jun 2026 17:33:47 +0530
Subject: drm/xe: Disable SVM support with fallback stubs

Provide GPUSVM integration for the Xe driver behind the
CPTCFG_DRM_XE_GPUSVM config, including struct xe_svm_range, struct xe_pagemap
and helper inline APIs for range/pagemap operations and address resolution.
Add notifier-lock macros and utility functions for range management, migration,
and page handling.

Also include fallback path when upstream DRM GPUSVM is not available supplying
inline stubs and default behaviors so the driver can build and operate without
GPUSVM support.

Signed-off-by: Varun Gupta <varun.gupta@intel.com>
---
 drivers/gpu/drm/xe/xe_svm.h | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/xe/xe_svm.h b/drivers/gpu/drm/xe/xe_svm.h
index 80ffec1..528bd38 100644
--- a/drivers/gpu/drm/xe/xe_svm.h
+++ b/drivers/gpu/drm/xe/xe_svm.h
@@ -6,12 +6,12 @@
 #ifndef _XE_SVM_H_
 #define _XE_SVM_H_
 
-#if IS_ENABLED(CPTCFG_DRM_XE_GPUSVM)
-
 #include <drm/drm_pagemap.h>
 #include <drm/drm_gpusvm.h>
 #include <drm/drm_pagemap_util.h>
 
+#if IS_ENABLED(CPTCFG_DRM_XE_GPUSVM) && !defined(XE_SVM_FORCE_FALLBACK)
+
 #define XE_INTERCONNECT_VRAM DRM_INTERCONNECT_DRIVER
 #define XE_INTERCONNECT_P2P (XE_INTERCONNECT_VRAM + 1)
 
@@ -191,6 +191,14 @@ int xe_pagemap_cache_create(struct xe_tile *tile);
 struct drm_pagemap *xe_drm_pagemap_from_fd(int fd, u32 region_instance);
 
 #else
+
+/* Fallback macros for missing upstream DRM stubs */
+#define drm_gpusvm_get_pages(...) (-EOPNOTSUPP)
+#define drm_gpusvm_unmap_pages(...) do {} while (0)
+#define drm_gpusvm_free_pages(...) do {} while (0)
+#define drm_gpusvm_fini(...) do {} while (0)
+#define drm_pagemap_get_from_cache_if_active(...) (NULL)
+
 #include <linux/interval_tree.h>
 #include "xe_vm.h"
 
@@ -232,7 +240,7 @@ int xe_devm_add(struct xe_tile *tile, struct xe_vram_region *vr)
 static inline
 int xe_svm_init(struct xe_vm *vm)
 {
-#if IS_ENABLED(CPTCFG_DRM_GPUSVM)
+#if IS_ENABLED(CPTCFG_DRM_XE_GPUSVM) && !defined(XE_SVM_FORCE_FALLBACK)
 	return drm_gpusvm_init(&vm->svm.gpusvm, "Xe SVM (simple)", &vm->xe->drm,
 			       NULL, 0, 0, 0, NULL, NULL, 0);
 #else
@@ -390,7 +398,7 @@ static inline struct drm_pagemap *xe_drm_pagemap_from_fd(int fd, u32 region_inst
 #define xe_svm_range_has_dma_mapping(...) false
 #endif /* CPTCFG_DRM_XE_GPUSVM */
 
-#if IS_ENABLED(CPTCFG_DRM_GPUSVM) /* Need to support userptr without XE_GPUSVM */
+#if IS_ENABLED(CPTCFG_DRM_GPUSVM) && !defined(XE_SVM_FORCE_FALLBACK)/* Need to support userptr without XE_GPUSVM */
 #define xe_svm_assert_in_notifier(vm__) \
 	lockdep_assert_held_write(&(vm__)->svm.gpusvm.notifier_lock)
 
