# this has the configuration for the backport code
source "$BACKPORT_DIR/compat/Kconfig"

# these are copied from the kernel
source "$BACKPORT_DIR/drivers/gpu/drm/xe/Kconfig"
source "$BACKPORT_DIR/drivers/mtd/devices/Kconfig"

# pmt
source "$BACKPORT_DIR/drivers/platform/x86/intel/pmt/Kconfig"
source "$BACKPORT_DIR/drivers/platform/x86/intel/Kconfig"

#VFIO
if BUILD_FULL_VFIO
source "$BACKPORT_DIR/drivers/vfio/Kconfig"
endif
if !BUILD_FULL_VFIO
source "$BACKPORT_DIR/drivers/vfio/pci/xe/Kconfig"
endif
