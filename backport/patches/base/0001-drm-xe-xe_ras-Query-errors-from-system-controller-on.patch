-	}
-
-	ret = ras_status_to_errno(response.status);
-	if (ret) {
-		xe_err(xe, "sysctrl: set health command failed with status %#x\n",
-		       response.status);
-		return ret;
-	}
-
-	if (response.health >= XE_RAS_HEALTH_MAX) {
-		xe_err(xe, "sysctrl: invalid health state %u\n",
