From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Varun Gupta <varun.gupta@intel.com>
Date: Tue, 17 Jun 2026 00:00:01 +0530
Subject: drm/xe: align userptr runtime behavior with full-SVM gating

Align runtime behavior across SVM/userptr paths for targets where full SVM
is conditionally disabled due to pagemap API gaps.

- Introduce/use XE_FULL_SVM consistently in SVM runtime paths
- Gate full-SVM-only logic in xe_svm.c and xe_pt.c
- Keep xe_vm map-op creation compatible with both req and legacy gpuvm signatures

Signed-off-by: Varun Gupta <varun.gupta@intel.com>
---
 drivers/gpu/drm/xe/xe_pt.c  | 2 +-
 drivers/gpu/drm/xe/xe_svm.c | 4 ++++
 drivers/gpu/drm/xe/xe_vm.c  | 4 ++--
 3 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/xe/xe_svm.c b/drivers/gpu/drm/xe/xe_svm.c
--- a/drivers/gpu/drm/xe/xe_svm.c
+++ b/drivers/gpu/drm/xe/xe_svm.c
@@ -24,6 +24,8 @@
 #include "xe_vm_types.h"
 #include "xe_vram_types.h"
 
+#if XE_FULL_SVM
+
 /* Identifies subclasses of struct drm_pagemap_peer */
 #define XE_PEER_PAGEMAP ((void *)0ul)
 #define XE_PEER_VM ((void *)1ul)
@@ -2026,3 +2028,5 @@
 	if (xe_vm_in_fault_mode(vm))
 		flush_work(&vm->svm.garbage_collector.work);
 }
+
+#endif /* XE_FULL_SVM */
 
diff --git a/drivers/gpu/drm/xe/xe_pt.c b/drivers/gpu/drm/xe/xe_pt.c
--- a/drivers/gpu/drm/xe/xe_pt.c
+++ b/drivers/gpu/drm/xe/xe_pt.c
@@ -1468,7 +1468,7 @@
 			err = vma_check_userptr(vm, gpuva_to_vma(op->base.prefetch.va), pt_update);
 		}
 		break;
-#if IS_ENABLED(CONFIG_DRM_XE_GPUSVM)
+#if XE_FULL_SVM
 	case DRM_GPUVA_OP_DRIVER:
 		if (op->subop == XE_VMA_SUBOP_MAP_RANGE) {
 			struct xe_svm_range *range = op->map_range.range;
 
diff --git a/drivers/gpu/drm/xe/xe_vm.c b/drivers/gpu/drm/xe/xe_vm.c
--- a/drivers/gpu/drm/xe/xe_vm.c
+++ b/drivers/gpu/drm/xe/xe_vm.c
@@ -2297,7 +2297,7 @@ vm_bind_ioctl_ops_create(struct xe_vm *vm, struct xe_vma_ops *vops,
 			.map.gem.offset = bo_offset_or_userptr,
 		};
 
-		ops = drm_gpuvm_sm_map_ops_create(&vm->gpuvm, &map_req);
+		ops = drm_gpuvm_sm_map_ops_create(&vm->gpuvm, &map_req);
 		break;
 	}
 	case DRM_XE_VM_BIND_OP_UNMAP:
@@ -3511,8 +3511,7 @@ static int vm_bind_ioctl_check_args(struct xe_device *xe,
 		bool comp_en;
 
 		if (XE_IOCTL_DBG(xe, is_cpu_addr_mirror &&
-				 (!xe_vm_in_fault_mode(vm) ||
-				 !IS_ENABLED(CONFIG_DRM_XE_GPUSVM)))) {
+				 (!xe_vm_in_fault_mode(vm) || !XE_FULL_SVM))) {
 			err = -EINVAL;
 			goto free_bind_ops;
 		}
@@ -4496,7 +4502,7 @@ static int xe_vm_alloc_vma(struct xe_vm *vm,
 	if (is_madvise)
 		ops = drm_gpuvm_madvise_ops_create(&vm->gpuvm, map_req);
 	else
-		ops = drm_gpuvm_sm_map_ops_create(&vm->gpuvm, map_req);
+		ops = drm_gpuvm_sm_map_ops_create(&vm->gpuvm, map_req);
 
 	if (IS_ERR(ops))
 		return PTR_ERR(ops);
 
-- 
 2.43.0
 
