diff --git a/drivers/gpu/drm/xe/xe_exec_queue.c b/drivers/gpu/drm/xe/xe_exec_queue.c
index 91a9d78b1..eb0bbf36b 100644
--- a/drivers/gpu/drm/xe/xe_exec_queue.c
+++ b/drivers/gpu/drm/xe/xe_exec_queue.c
@@ -157,9 +157,17 @@ static void __xe_exec_queue_free(struct xe_exec_queue *q)
 
 	if (q->vm) {
 		xe_vm_remove_exec_queue(q->vm, q);
+		if (q->vm->xef)
+			xe_vm_remove_close_queue(q->vm);
 		xe_vm_put(q->vm);
 	}
 
+	if (q->user_vm) {
+		if (q->user_vm_close_tracked)
+			xe_vm_remove_close_queue(q->user_vm);
+		xe_vm_put(q->user_vm);
+	}
+
 	if (q->xef)
 		xe_file_put(q->xef);
 
@@ -253,8 +261,12 @@ static struct xe_exec_queue *__xe_exec_queue_alloc(struct xe_device *xe,
 		}
 	}
 
-	if (vm)
+	if (vm) {
 		q->vm = xe_vm_get(vm);
+		/* vm->xef stays unchanged until final VM destruction. */
+		if (vm->xef)
+			xe_vm_add_close_queue(vm);
+	}
 
 	if (extensions) {
 		/*
@@ -1506,6 +1518,10 @@ int xe_exec_queue_create_ioctl(struct drm_device *dev, void *data,
 
 			new = xe_exec_queue_create_bind(xe, tile, vm, flags,
 							args->extensions);
+			if (!IS_ERR(new)) {
+				new->user_vm_close_tracked = true;
+				xe_vm_add_close_queue(vm);
+			}
 			if (IS_ERR(new)) {
 				up_read(&vm->lock);
 				xe_vm_put(vm);
@@ -1591,6 +1607,7 @@ int xe_exec_queue_create_ioctl(struct drm_device *dev, void *data,
 	}
 
 	q->xef = xe_file_get(xef);
+
 	if (eci[0].engine_class != DRM_XE_ENGINE_CLASS_VM_BIND)
 		xe_vm_add_exec_queue(vm, q);
 
@@ -1807,17 +1824,22 @@ int xe_exec_queue_destroy_ioctl(struct drm_device *dev, void *data,
 
 	mutex_lock(&xef->exec_queue.lock);
 	q = xa_erase(&xef->exec_queue.xa, args->exec_queue_id);
-	if (q)
+	if (q) {
+		WRITE_ONCE(q->user_closed, true);
 		atomic_inc(&xef->exec_queue.pending_removal);
+	}
 	mutex_unlock(&xef->exec_queue.lock);
 
 	if (XE_IOCTL_DBG(xe, !q))
 		return -ENOENT;
 
+	wake_up_all(&xe->ufence_wq);
+
 	if (q->vm && q->hwe->hw_engine_group)
 		xe_hw_engine_group_del_exec_queue(q->hwe->hw_engine_group, q);
 
-	xe_exec_queue_kill(q);
+	if (!(q->flags & EXEC_QUEUE_FLAG_VM))
+		xe_exec_queue_kill(q);
 	prelim_xe_eudebug_exec_queue_destroy(xef, q);
 
 	trace_xe_exec_queue_close(q);
